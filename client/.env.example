# CampusShare Frontend Client Environment Configuration Example

# API Base URL (Must include /api/v1 prefix)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_URL=http://localhost:5000/api/v1

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=campusshare-701ad.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=campusshare-701ad
VITE_FIREBASE_STORAGE_BUCKET=campusshare-701ad.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
